{
  "name": "mwc-advocates-server",
  "version": "1.0.0",
  "description": "PERN Stack backend for MWC Advocates law firm website",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "npx prisma db push && npx prisma db seed && node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node src/utils/seed.ts",
    "db:studio": "prisma studio",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "echo \"Linting not configured yet\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "nodemailer": "^7.0.5",
    "@types/node": "^24.3.0",
    "@types/express": "^4.17.23",
    "@types/cors": "^2.8.19",
    "@types/morgan": "^1.9.10",
    "@types/compression": "^1.8.1",
    "@types/nodemailer": "^7.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/bcryptjs": "^3.0.0",
    "typescript": "^5.9.2",
    "ts-node": "^10.9.2",
    "prisma": "^6.14.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "prisma": {
    "seed": "ts-node src/utils/seed.ts"
  }
}
