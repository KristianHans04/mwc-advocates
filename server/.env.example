# MWC Advocates Server Environment Variables
# Copy this file to .env and fill in your actual values
#
# ⚠️ SECURITY WARNING:
# - NEVER commit .env files with real credentials to git
# - Use app-specific passwords for email services (not your main password)
# - Rotate credentials immediately if they are ever exposed
#
# DEPLOYMENT CHECKLIST:
# 1. Set NODE_ENV=production
# 2. Update DATABASE_URL with your database credentials
# 3. Update FRONTEND_URL with your deployed frontend domain
# 4. Set ZOHO_SMTP_PASS with your Zoho App-Specific Password
# 5. Generate a secure JWT_SECRET (use: openssl rand -base64 32)

# ===================
# Server Configuration
# ===================
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-frontend-domain.com
WEBSITE_URL=https://your-domain.com

# ===================
# Database Configuration
# ===================
# For Supabase (recommended for production):
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# For local PostgreSQL (development):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mwc_advocates_dev?schema=public"

# ===================
# Email Configuration (Zoho SMTP)
# ===================
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USER=your-email@yourdomain.com
ZOHO_SMTP_PASS=your_zoho_app_specific_password
EMAIL_FROM="MWC Advocates <your-email@yourdomain.com>"
ADMIN_EMAIL=admin@yourdomain.com

# ===================
# Security
# ===================
# Generate with: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters
JWT_EXPIRE=24h

# ===================
# Rate Limiting
# ===================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CONTACT_RATE_LIMIT_MAX=5

# ===================
# File Uploads (Future)
# ===================
MAX_FILE_SIZE=10mb
UPLOAD_PATH=./uploads
