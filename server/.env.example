# MWC Advocates Server Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/mwc_advocates?schema=public"

# Email Configuration - SparkPost
SPARKPOST_API_KEY=your_sparkpost_api_key_here
SPARKPOST_DOMAIN=kristianhans.com
EMAIL_FROM="MWC Advocates <noreply@kristianhans.com>"
ADMIN_EMAIL=info@kristianhans.com
WEBSITE_URL=http://localhost:5173

# JWT Configuration (for future admin authentication)
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRE=24h

# Upload Configuration
MAX_FILE_SIZE=10mb
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CONTACT_RATE_LIMIT_MAX=5
