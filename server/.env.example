# MWC Advocates Server Environment Variables - PRODUCTION READY
# Copy this file to .env and fill in your actual values

# RENDER DEPLOYMENT SETTINGS:
# 1. Set NODE_ENV=production
# 2. Update DATABASE_URL with your Supabase credentials  
# 3. Update FRONTEND_URL with your deployed frontend domain
# 4. Set ZOHO_SMTP_PASS with your Zoho App Password
# 5. Generate a secure JWT_SECRET

# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-frontend-domain.com

# Database - Supabase Production (Required)
DATABASE_URL="postgresql://postgres.XXXXX:YOUR_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=10"

# Email Configuration - Zoho Mail SMTP (Required)
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USER=hello@kristianhans.com
ZOHO_SMTP_PASS=your_zoho_app_password
EMAIL_FROM="MWC Advocates <hello@kristianhans.com>"
ADMIN_EMAIL=hello@kristianhans.com

# Website URL (Update with your production domain)
WEBSITE_URL=https://your-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# JWT Secret (Required - Change this!)
JWT_SECRET=your_super_secret_jwt_key_for_production_use_a_long_random_string

# Email Configuration - SparkPost
SPARKPOST_API_KEY=your_sparkpost_api_key_here
SPARKPOST_DOMAIN=kristianhans.com
EMAIL_FROM="MWC Advocates <noreply@kristianhans.com>"
ADMIN_EMAIL=info@kristianhans.com
WEBSITE_URL=http://localhost:5173

# JWT Configuration (for future admin authentication)
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRE=24h

# Upload Configuration
MAX_FILE_SIZE=10mb
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CONTACT_RATE_LIMIT_MAX=5
