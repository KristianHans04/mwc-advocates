# Development Environment Variables for MWC Advocates
# This file is for local development only

# Server Configuration
PORT=5000
NODE_ENV=development

# Database - Use local PostgreSQL for development
# Option 1: Local PostgreSQL (recommended for development)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mwc_advocates_dev?schema=public"

# Option 2: Supabase (if you want to use cloud DB in development)
# Uncomment the line below and comment out the local one
# DATABASE_URL="postgresql://postgres.ujuaihafpryvfxajlqqo:oglBxpK6SvNuVrFw@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=10"

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Email Configuration - MailHog for Development
# MailHog doesn't need authentication, these are just for display
EMAIL_FROM="MWC Advocates <noreply@mwc-advocates.local>"
ADMIN_EMAIL=admin@mwc-advocates.local

# Don't use Zoho in development - comment these out
# ZOHO_SMTP_HOST=smtp.zoho.com
# ZOHO_SMTP_PORT=587
# ZOHO_SMTP_USER=hello@kristianhans.com
# ZOHO_SMTP_PASS=***REMOVED***

# Google Sheets (optional - for fallback)
# GOOGLE_SHEET_ID=your_google_sheet_id
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# JWT Secret (for future authentication if needed)
JWT_SECRET=mwc_advocates_dev_secret_key_2024

# Website URL
WEBSITE_URL=http://localhost:5173