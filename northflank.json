{
  "name": "mwc-advocates",
  "description": "MWC Advocates PERN Stack Law Firm Website",
  "version": "1.0.0",
  "spec": {
    "kind": "CombinedService",
    "build": {
      "dockerfile": {
        "buildEngine": "buildkit",
        "dockerfilePath": "/Dockerfile",
        "dockerContext": "/"
      }
    },
    "deployment": {
      "instances": 1,
      "docker": {
        "configType": "default"
      },
      "ports": [
        {
          "name": "http",
          "internalPort": 5000,
          "public": true,
          "protocol": "HTTP",
          "domains": []
        }
      ],
      "healthcheck": {
        "path": "/health",
        "port": 5000,
        "initialDelaySeconds": 40,
        "periodSeconds": 30,
        "timeoutSeconds": 10,
        "successThreshold": 1,
        "failureThreshold": 3
      }
    },
    "runtimeEnvironment": {
      "NODE_ENV": "production",
      "PORT": "5000"
    },
    "buildArguments": {}
  }
}
